{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@radar-domace/api": [
        "packages/api/src"
      ],
      "@radar-domace/types": [
        "packages/types/src"
      ],
      "@radar-domace/analytics": [
        "packages/analytics/src"
      ],
      "@radar-domace/config": [
        "packages/config/src"
      ]
    }
  }
}
